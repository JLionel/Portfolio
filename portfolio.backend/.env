## Only used in local dev outside docker
### DB Env

POSTGRES_USER=postgres
POSTGRES_DB=next_tuto
POSTGRES_PASSWORD_FILE=superpass

### Server Env

IS_DOCKER=false
IS_DEV=true
DB_HOST=localhost
DB_PORT=5432
NEXT_TUTO_DB_NAME="${POSTGRES_DB}"
DB_USER="${POSTGRES_USER}"
DB_PASSWORD="${POSTGRES_PASSWORD_FILE}"

